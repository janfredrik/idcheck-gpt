  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single blue action on a surface; label left, arrow right.",
      "html": "<button class=\"ds-btn-primary\">Fortsett med Vipps <span aria-hidden=\"true\">→</span></button>",
      "css": ".ds-btn-primary{font-family:Nunito Sans,'Avenir Next','Segoe UI',system-ui,sans-serif;display:flex;width:320px;height:54px;align-items:center;justify-content:space-between;padding:0 16px;border:0;border-radius:10px;background:linear-gradient(100deg,#2868ef,#3979f7);box-shadow:0 5px 13px rgba(51,110,232,.18);color:#fff;font-size:14px;font-weight:600;cursor:pointer;transition:transform .18s,filter .18s}.ds-btn-primary span{font-size:20px;font-weight:400}.ds-btn-primary:hover{filter:brightness(1.05);transform:translateY(-1px)}.ds-btn-primary:focus-visible{outline:3px solid #77c9cf;outline-offset:3px}.ds-btn-primary:disabled{opacity:.52;cursor:not-allowed}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "White, thin border; copy, previous, reject.",
      "html": "<button class=\"ds-btn-secondary\">Kopier engangskode</button>",
      "css": ".ds-btn-secondary{font-family:Nunito Sans,'Avenir Next','Segoe UI',system-ui,sans-serif;height:43px;padding:0 18px;border:1px solid #dfe8e8;border-radius:9px;background:#fff;color:#47616a;font-size:12px;font-weight:600;cursor:pointer}.ds-btn-secondary:hover{background:#f7fbfa}.ds-btn-secondary:focus-visible{outline:3px solid #77c9cf;outline-offset:3px}"
    },
    {
      "name": "Approve Button",
      "kind": "button",
      "refersTo": "button-approve",
      "description": "Green simulation approve control, the only colored secondary.",
      "html": "<button class=\"ds-btn-approve\">Simuler godkjenning</button>",
      "css": ".ds-btn-approve{font-family:Nunito Sans,'Avenir Next','Segoe UI',system-ui,sans-serif;width:280px;height:43px;border:1px solid #c5e5da;border-radius:7px;background:#eef9f4;color:#18785e;font-size:12px;font-weight:600;cursor:pointer}.ds-btn-approve:hover{background:#e2f5ed}.ds-btn-approve:focus-visible{outline:3px solid #77c9cf;outline-offset:3px}"
    },
    {
      "name": "Phone Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Tall field with fixed +47 prefix and blue focus ring.",
      "html": "<label class=\"ds-label\">MOBILNUMMER</label><div class=\"ds-phone\"><span class=\"ds-prefix\">+47</span><i></i><input placeholder=\"412 34 567\" inputmode=\"tel\"></div>",
      "css": ".ds-label{font-family:Nunito Sans,'Avenir Next','Segoe UI',system-ui,sans-serif;display:block;margin-bottom:10px;color:#53636d;font-size:11px;font-weight:700;letter-spacing:.1em}.ds-phone{font-family:Nunito Sans,'Avenir Next','Segoe UI',system-ui,sans-serif;display:flex;width:320px;height:55px;align-items:center;padding-left:16px;border:1px solid #dfe5e8;border-radius:10px;background:#fff;transition:border-color .2s,box-shadow .2s}.ds-phone:focus-within{border-color:#85a7f7;box-shadow:0 0 0 3px rgba(62,117,246,.1)}.ds-prefix{color:#526570;font-size:16px}.ds-phone i{width:1px;height:19px;margin:0 12px;background:#e5e9eb}.ds-phone input{flex:1;min-width:0;height:100%;border:0;outline:0;background:transparent;color:#1b2a36;font:inherit;font-size:16px}"
    },
    {
      "name": "Step Rail",
      "kind": "nav",
      "description": "Numbered step circles on the night background.",
      "html": "<div class=\"ds-rail\"><span class=\"done\"><i>1</i>Nummer</span><b></b><span class=\"active\"><i>2</i>Vipps</span><b></b><span><i>3</i>Engangskode</span></div>",
      "css": ".ds-rail{font-family:Nunito Sans,'Avenir Next','Segoe UI',system-ui,sans-serif;display:flex;align-items:center;gap:12px;padding:16px;background:#07131f;color:#81949d;font-size:12px}.ds-rail span{display:flex;align-items:center;gap:7px}.ds-rail i{display:grid;width:22px;height:22px;place-items:center;border:1px solid rgba(187,211,216,.24);border-radius:50%;font-style:normal;font-size:11px}.ds-rail .active{color:#b8f0eb}.ds-rail .active i{border-color:#6dcac5;background:rgba(95,199,195,.13)}.ds-rail .done i{border-color:rgba(105,194,185,.45);color:#a9d9d5}.ds-rail b{width:30px;height:1px;background:rgba(188,212,218,.18)}"
    },
    {
      "name": "Live Pill",
      "kind": "chip",
      "refersTo": "live-pill",
