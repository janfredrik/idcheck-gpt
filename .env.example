# Fill these values on the Unraid host. Never commit a real .env file or Entra secret.
IDCHECK_IMAGE=ghcr.io/janfredrik/idcheck-gpt:latest
IDCHECK_PORT=3000
POSTGRES_PASSWORD=

# This first release is fixed to exactly one explicitly named demo tenant.
IDCHECK_MODE=demo
DEMO_ENABLED=false
DEMO_TAP_ENABLED=false
DEMO_TENANT_ID=
DEMO_TENANT_NAME=
DEMO_ALLOWED_USER_IDS=
DEMO_ALLOWED_GROUP_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
RATE_LIMIT_HMAC_KEY=
ALERT_EMAIL=
PUBLIC_BASE_URL=https://idcheck.example.no

# Required in production. Also put the app behind a trusted HTTPS reverse proxy.
APP_ACCESS_USER=
APP_ACCESS_PASSWORD=

# SMTP is required for the notification worker to send queued attempt alerts.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
